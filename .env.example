# Copy this file to ".env" (same folder) and fill in your values.
# .env is git-ignored, so your real credentials never get committed.
# In GitHub Actions the same names are read from repo Secrets instead.

# Which environment to test: stg | preprod | production
ENV=stg

# ---- Sanad login ----
# National ID and password, shared by every environment...
API_LOGIN_ID=
API_LOGIN_PASSWORD=

# ...or per environment (these win when that ENV is active)
# STG_API_LOGIN_ID=
# STG_API_LOGIN_PASSWORD=
# PREPROD_API_LOGIN_ID=
# PREPROD_API_LOGIN_PASSWORD=
# PRODUCTION_API_LOGIN_ID=
# PRODUCTION_API_LOGIN_PASSWORD=

# ---- Report emails (Gmail + App Password). Leave empty to skip emails. ----
MAIL_USERNAME=
MAIL_PASSWORD=
# Comma-separated recipients
MAIL_TO=
# When to email: always (default) | failures | never
# MAIL_SEND_ON=always

# Optional one-off URL override (beats base_url in priorities.yaml)
# BASE_URL=https://...
